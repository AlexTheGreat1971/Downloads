+                SurfaceBody ReacquireTrimInputBody584(SurfaceBody x584Original, double x584ExpectedVolume, out string x584Detail)
+                {
+                    // B-Rep references are not guaranteed to survive a feature delete + recompute.
+                    // Re-acquire the pre-trim ring from the part by its exact volume; keep the old
+                    // reference only when no solid with that volume exists.
+                    x584Detail = "keep-original-reference";
+                    double x584Tolerance = Math.Max(1e-9, Math.Abs(x584ExpectedVolume) * 1e-6);
+                    SurfaceBody x584Best = null;
+                    double x584BestDelta = double.PositiveInfinity;
+                    int x584Candidates = 0;
+                    try
+                    {
+                        foreach (SurfaceBody x584Candidate in def.SurfaceBodies)
+                        {
+                            if (x584Candidate == null || !x584Candidate.IsSolid) continue;
+                            double x584CandidateVolume;
+                            try { x584CandidateVolume = x584Candidate.MassProperties.Volume; }
+                            catch { continue; }
+                            double x584Delta = Math.Abs(x584CandidateVolume - x584ExpectedVolume);
+                            if (!double.IsFinite(x584Delta) || x584Delta > x584Tolerance) continue;
+                            x584Candidates++;
+                            if (x584Delta < x584BestDelta) { x584Best = x584Candidate; x584BestDelta = x584Delta; }
+                        }
+                    }
+                    catch (Exception x584EnumerationException)
+                    {
+                        x584Detail = "reacquire-enumeration-failed;" + x584EnumerationException.GetType().Name;
+                        return x584Original;
+                    }
+                    if (x584Best == null)
+                    {
+                        x584Detail = "reacquire-no-solid-with-input-volume;candidates=0";
+                        return x584Original;
+                    }
+                    x584Detail = string.Format(CultureInfo.InvariantCulture,
+                        "reacquired-by-input-volume;candidates={0};volumeDeltaCm3={1:R}", x584Candidates, x584BestDelta);
+                    return x584Best;
+                }
+
+                string ClassifyFirstTrimResultByVolume584(double x584ResultVolume, double x584InputVolume,
+                    double x584PredictedKeep, double x584PredictedRemove)
+                {
+                    if (!double.IsFinite(x584ResultVolume) || !double.IsFinite(x584PredictedKeep) ||
+                        !double.IsFinite(x584PredictedRemove))
+                        return "prediction-unavailable";
+                    double x584Tolerance = Math.Max(1e-9, Math.Abs(x584InputVolume) * 1e-6);
+                    bool x584NearKeep = Math.Abs(x584ResultVolume - x584PredictedKeep) <= x584Tolerance;
+                    bool x584NearRemove = Math.Abs(x584ResultVolume - x584PredictedRemove) <= x584Tolerance;
+                    if (x584NearKeep && !x584NearRemove) return "keep-piece";
+                    if (x584NearRemove && !x584NearKeep) return "remove-piece";
+                    if (x584NearKeep && x584NearRemove) return "ambiguous-equal-pieces";
+                    return "unexpected-volume";
+                }
+
+                double TransientVolumeOrNaN584(SurfaceBody x584Body)
+                {
+                    if (x584Body == null) return 0.0;
+                    try
+                    {
+                        if (!x584Body.IsSolid || x584Body.Faces == null || x584Body.Faces.Count == 0) return 0.0;
+                        SurfaceBodyMassProperties x584Mass = x584Body.MassProperties;
+                        return x584Mass == null ? double.NaN : x584Mass.Volume;
+                    }
+                    catch { return double.NaN; }
+                }
+
+                SurfaceBody CreatePlaneHalfSpace584(double[] x584Origin, double[] x584Direction, double x584SizeCm)
+                {
+                    // Exact half-space on the +Z side of the local frame, built with the same
+                    // CreateSolidBlock + Transform calls as the runtime-audit fixture generator.
+                    double[] x584Z = Norm(x584Direction);
+                    if (x584Z == null || x584Z.Length != 3) return null;
+                    double[] x584Helper = Math.Abs(x584Z[2]) < 0.9 ? new[] { 0.0, 0.0, 1.0 } : new[] { 1.0, 0.0, 0.0 };
+                    double[] x584X = Norm(Cross(x584Helper, x584Z));
+                    if (x584X == null || x584X.Length != 3) return null;
+                    double[] x584Y = Cross(x584Z, x584X);
+                    Box x584Block = tg.CreateBox();
+                    x584Block.MinPoint = tg.CreatePoint(-x584SizeCm, -x584SizeCm, 0.0);
+                    x584Block.MaxPoint = tg.CreatePoint(x584SizeCm, x584SizeCm, x584SizeCm);
+                    SurfaceBody x584HalfSpace = app.TransientBRep.CreateSolidBlock(x584Block);
+                    Matrix x584Frame = tg.CreateMatrix();
+                    x584Frame.SetCoordinateSystem(
+                        tg.CreatePoint(x584Origin[0], x584Origin[1], x584Origin[2]),
+                        tg.CreateVector(x584X[0], x584X[1], x584X[2]),
+                        tg.CreateVector(x584Y[0], x584Y[1], x584Y[2]),
+                        tg.CreateVector(x584Z[0], x584Z[1], x584Z[2]));
+                    app.TransientBRep.Transform(x584HalfSpace, x584Frame);
+                    return x584HalfSpace;
+                }
