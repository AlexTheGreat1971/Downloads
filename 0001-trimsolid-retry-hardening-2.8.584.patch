+                bool TryPredictPlanarPartition584(SurfaceBody x584Input, SurfaceTrimFaceSpec x584Spec,
+                    IList<double[]> x584KeepWitnesses, double x584InputVolume,
+                    out double x584KeepVolume, out double x584RemoveVolume, out string x584Detail)
+                {
+                    // Exact keep/remove partition of the input ring by the plane of a planar neighbour.
+                    // The side comes from the geometric keep witnesses, never from a normal convention, so the
+                    // prediction is independent of TrimSolid's positive-side semantics.
+                    x584KeepVolume = double.NaN;
+                    x584RemoveVolume = double.NaN;
+                    x584Detail = "not-applicable";
+                    if (x584Input == null || x584Spec == null || x584Spec.SurfaceType != SurfaceTypeEnum.kPlaneSurface ||
+                        x584Spec.SourceFace == null || x584KeepWitnesses == null || x584KeepWitnesses.Count == 0)
+                        return false;
+                    try
+                    {
+                        Plane x584Plane = x584Spec.SourceFace.Geometry as Plane;
+                        if (x584Plane == null || x584Plane.RootPoint == null || x584Plane.Normal == null)
+                        {
+                            x584Detail = "source-plane-geometry-unavailable";
+                            return false;
+                        }
+                        double[] x584Root = { x584Plane.RootPoint.X, x584Plane.RootPoint.Y, x584Plane.RootPoint.Z };
+                        double[] x584Normal = Norm(new[] { x584Plane.Normal.X, x584Plane.Normal.Y, x584Plane.Normal.Z });
+                        if (x584Normal == null || x584Normal.Length != 3)
+                        {
+                            x584Detail = "source-plane-frame-invalid";
+                            return false;
+                        }
+                        double x584KeepSign = 0.0;
+                        double x584BestDistance = 0.0;
+                        foreach (double[] x584Witness in x584KeepWitnesses)
+                        {
+                            if (x584Witness == null || x584Witness.Length != 3) continue;
+                            double x584Signed = Dot(Sub(x584Witness, x584Root), x584Normal);
+                            if (!double.IsFinite(x584Signed)) continue;
+                            if (Math.Abs(x584Signed) > x584BestDistance)
+                            {
+                                x584BestDistance = Math.Abs(x584Signed);
+                                x584KeepSign = x584Signed >= 0.0 ? 1.0 : -1.0;
+                            }
+                        }
+                        if (x584KeepSign == 0.0 || x584BestDistance <= 1e-8)
+                        {
+                            x584Detail = "keep-side-unresolved";
+                            return false;
+                        }
+                        double[] x584RemoveDirection =
+                        {
+                            -x584KeepSign * x584Normal[0], -x584KeepSign * x584Normal[1], -x584KeepSign * x584Normal[2]
+                        };
+                        dynamic x584Range = x584Input.RangeBox;
+                        double[] x584Min = { (double)x584Range.MinPoint.X, (double)x584Range.MinPoint.Y, (double)x584Range.MinPoint.Z };
+                        double[] x584Max = { (double)x584Range.MaxPoint.X, (double)x584Range.MaxPoint.Y, (double)x584Range.MaxPoint.Z };
+                        double[] x584Center = { 0.5 * (x584Min[0] + x584Max[0]), 0.5 * (x584Min[1] + x584Max[1]), 0.5 * (x584Min[2] + x584Max[2]) };
+                        double x584Offset = Dot(Sub(x584Center, x584Root), x584Normal);
+                        double[] x584Origin =
+                        {
+                            x584Center[0] - x584Offset * x584Normal[0],
+                            x584Center[1] - x584Offset * x584Normal[1],
+                            x584Center[2] - x584Offset * x584Normal[2]
+                        };
+                        double x584Size = Math.Max(1.0, 3.0 * Distance3(x584Min, x584Max));
+
+                        SurfaceBody x584RemoveProbe = app.TransientBRep.Copy(x584Input);
+                        SurfaceBody x584RemoveTool = CreatePlaneHalfSpace584(x584Origin, x584RemoveDirection, x584Size);
+                        SurfaceBody x584KeepProbe = app.TransientBRep.Copy(x584Input);
+                        SurfaceBody x584KeepTool = CreatePlaneHalfSpace584(x584Origin, x584RemoveDirection, x584Size);
+                        if (x584RemoveProbe == null || x584RemoveTool == null || x584KeepProbe == null || x584KeepTool == null)
+                        {
+                            x584Detail = "transient-copy-or-half-space-unavailable";
+                            return false;
+                        }
+                        app.TransientBRep.DoBoolean(x584RemoveProbe, x584RemoveTool, BooleanTypeEnum.kBooleanTypeIntersect);
+                        app.TransientBRep.DoBoolean(x584KeepProbe, x584KeepTool, BooleanTypeEnum.kBooleanTypeDifference);
+                        double x584RemoveVol = TransientVolumeOrNaN584(x584RemoveProbe);
+                        double x584KeepVol = TransientVolumeOrNaN584(x584KeepProbe);
+                        double x584Mismatch = Math.Abs(x584KeepVol + x584RemoveVol - x584InputVolume);
+                        double x584Allowed = Math.Max(1e-9, Math.Abs(x584InputVolume) * 1e-6);
+                        x584Detail = string.Format(CultureInfo.InvariantCulture,
+                            "keepSign={0};predictedKeepCm3={1:R};predictedRemoveCm3={2:R};partitionMismatchCm3={3:R};allowedMismatchCm3={4:R}",
+                            x584KeepSign, x584KeepVol, x584RemoveVol, x584Mismatch, x584Allowed);
+                        if (!double.IsFinite(x584KeepVol) || !double.IsFinite(x584RemoveVol) || !(x584Mismatch <= x584Allowed))
+                        {
+                            x584Detail += ";partition-identity-failed";
+                            return false;
+                        }
+                        x584KeepVolume = x584KeepVol;
+                        x584RemoveVolume = x584RemoveVol;
+                        return true;
+                    }
+                    catch (Exception x584Exception)
+                    {
+                        x584Detail = "exact-partition-exception=" + x584Exception.GetType().Name +
+                            ";hresult=0x" + x584Exception.HResult.ToString("X8", CultureInfo.InvariantCulture) +
+                            ";message=" + x584Exception.Message;
+                        return false;
+                    }
+                }
