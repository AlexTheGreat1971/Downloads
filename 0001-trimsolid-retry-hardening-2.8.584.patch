+                // 2.8.584: helpers that make the TrimSolid side decision and the retry auditable.
+                // They use exact solid arithmetic and explicit COM-object validity checks instead of
+                // trusting normal-orientation conventions or object references across a feature delete.
+                bool IsSplitToolAlive584(object x584Tool, out string x584Detail)
+                {
+                    x584Detail = "split-tool-null";
+                    if (x584Tool == null) return false;
+                    try
+                    {
+                        dynamic x584ToolCom = x584Tool;
+                        string x584ToolName = Convert.ToString(x584ToolCom.Name, CultureInfo.InvariantCulture);
+                        x584Detail = "split-tool-alive;name=" + x584ToolName;
+                        return true;
+                    }
+                    catch (Exception x584ToolException)
+                    {
+                        x584Detail = "split-tool-invalid;" + x584ToolException.GetType().Name + ";hresult=0x" +
+                            x584ToolException.HResult.ToString("X8", CultureInfo.InvariantCulture);
+                        return false;
+                    }
+                }
